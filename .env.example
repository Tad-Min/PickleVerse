# Copy to .env and fill in your own credentials. Do not commit .env.

# Linux only: image digests from the workflow Summary and an absolute data directory.
PKV_API_IMAGE=
PKV_AI_IMAGE=
PKV_WEB_IMAGE=
PKV_GAME_SERVER_IMAGE=
PKV_DATA_ROOT=/mnt/data/pickleverse/data

# PostgreSQL and pgAdmin. Keep the existing PostgreSQL credentials for existing data.
POSTGRES_USER=sa
POSTGRES_PASSWORD=
POSTGRES_PORT=15432
POSTGRES_MAX_POOL_SIZE=40
PGADMIN_EMAIL=admin@pickleverse.com
PGADMIN_PASSWORD=
PGADMIN_BIND=127.0.0.1
PGADMIN_PORT=15050

# Redis and object storage.
REDIS_PORT=16379
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PORT=19000

# API and web. Caddy serves their public HTTPS address on Linux.
API_PORT=8080
WEB_PORT=3000
JWT_KEY=

# Optional Gmail SMTP. Use a Google App Password with 2-Step Verification enabled.
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=

# AI and Dedicated Server. Use separate secrets of at least 32 characters for JWT, AI and the worker.
AI_SERVICE_KEY=
AI_COACHING_CALIBRATION_SHA256=
PKV_GAME_SERVER_KEY=
PKV_GAME_CPUS=2
PKV_GAME_MEMORY=2g

# Local only: Linux uses its own bind mounts and enables AI in Compose.
POSTGRES_VOLUME=pickleverse_dev_postgres_data
AI_INGEST_ENABLED=false
AI_DISPATCHER_ENABLED=false
AI_COACHING_ENABLED=false
AI_ENABLE_MODEL=false
