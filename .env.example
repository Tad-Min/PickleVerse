# Copy to .env (ignored by Git). Use a random secret of at least 32 characters.
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Enable 2-Step Verification and create a Google App Password. Do not use your login password.
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
# Host ports avoid the manually running services on 5432/5050/9000.
POSTGRES_PORT=15432
# A fresh volume is initialized directly from src/Database.sql.
POSTGRES_VOLUME=pickleverse_dev_postgres_data
PGADMIN_PORT=15050
S3_PORT=19000
API_PORT=8080

# Enable after creating the development database from src/Database.sql.
AI_SERVICE_KEY=
AI_INGEST_ENABLED=false
AI_DISPATCHER_ENABLED=false
AI_COACHING_ENABLED=false
AI_ENABLE_MODEL=false
