{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/matchmaker/matchmaker-queue.schema.json",
  "name": "PickleVerse-1v1",
  "enabled": true,
  "maxPlayersPerTicket": 1,
  "defaultPool": {
    "name": "LowPing",
    "enabled": true,
    "timeoutSeconds": 360,
    "matchHosting": {
      "type": "MatchId"
    },
    "matchLogic": {
      "name": "Rules",
      "backfillEnabled": false,
      "matchDefinition": {
        "teams": [
          {
            "name": "Team",
            "teamCount": {
              "min": 2,
              "max": 2
            },
            "playerCount": {
              "min": 1,
              "max": 1
            },
            "teamRules": []
          }
        ],
        "matchRules": [
          {
            "name": "SameMeasuredRegion",
            "type": "Equality",
            "source": "Players.CustomData.region",
            "enableRule": true,
            "relaxations": []
          },
          {
            "name": "SameProtocol",
            "type": "Equality",
            "source": "Players.CustomData.protocol",
            "reference": "5",
            "enableRule": true
          },
          {
            "name": "EloWindow",
            "type": "Difference",
            "source": "Players.CustomData.elo",
            "reference": 120,
            "enableRule": true
          },
          {
            "name": "MutualPreference",
            "type": "Intersection",
            "source": "Players.CustomData.pairingKeys",
            "overlap": 1,
            "enableRule": true
          }
        ]
      }
    }
  },
  "filteredPools": []
}