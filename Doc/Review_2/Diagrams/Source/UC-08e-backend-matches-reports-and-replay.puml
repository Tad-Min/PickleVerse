@startuml UC-08e
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-08e - Backend matches, reports and replay
actor "Registered API user" as A_registered
actor "Trusted result producer (TARGET)" as A_trusted
rectangle "Independent backend API / partial source" {
  usecase "BUC-18\nCommit a completed match and rating change\n<<PARTIAL BACKEND SOURCE>>" as BUC_18 #FFF1D6
  usecase "BUC-19\nView personal match history\n<<PARTIAL BACKEND SOURCE>>" as BUC_19 #FFF1D6
  usecase "BUC-20\nReport another participant in a match\n<<PARTIAL BACKEND SOURCE>>" as BUC_20 #FFF1D6
  usecase "BUC-21\nStore and view a match replay\n<<PARTIAL BACKEND SOURCE>>" as BUC_21 #FFF1D6
}
A_trusted -- BUC_18
A_registered -- BUC_19
A_registered -- BUC_20
A_registered -- BUC_21
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
