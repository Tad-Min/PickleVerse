%% ERD-DB-A05: CURRENT SQL/EF — deployment not verified
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    Currencies {
        serial CurrencyId PK "NOT NULL"
        varchar_254 CurrencyName UK "NOT NULL"
        varchar_254 Description "NOT NULL"
    }
    PlayerCurrencies {
        uuid PlayerId PK,FK "NOT NULL"
        int CurrencyId PK,FK "NOT NULL"
        int Amount "NOT NULL"
    }
    Cosmetics {
        serial CosmeticId PK "NOT NULL"
        int CurrencyId FK "NOT NULL"
        varchar_50 ItemCode UK "NOT NULL"
        varchar_254 CosmeticName "NOT NULL"
        varchar_254 Description "NOT NULL"
        int Price "NOT NULL"
        varchar_25 Type "NOT NULL"
    }
    PlayerCosmetics {
        uuid PlayerId PK,FK "NOT NULL"
        int CosmeticId PK,FK "NOT NULL"
        boolean Equipped "NOT NULL"
    }
    PlayerProfiles {
        uuid UserId PK,FK "NOT NULL; reference only"
        varchar_18 PlayerName UK "NOT NULL; reference only"
    }
    PlayerProfiles ||--o{ PlayerCurrencies : "PlayerId"
    Currencies ||--o{ PlayerCurrencies : "CurrencyId"
    Currencies ||--o{ Cosmetics : "CurrencyId"
    PlayerProfiles ||--o{ PlayerCosmetics : "PlayerId"
    Cosmetics ||--o{ PlayerCosmetics : "CosmeticId"
