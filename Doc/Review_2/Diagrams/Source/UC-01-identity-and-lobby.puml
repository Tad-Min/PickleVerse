@startuml UC-01
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-01 - Identity and lobby
actor "Player" as A_player
actor "Unity Gaming Services" as A_ugs
actor "Future AI service" as A_futureai
rectangle "PickleVerse game / Identity and lobby" {
  usecase "G-UC01\nUse a local player profile\n<<SOURCE IMPLEMENTED>>" as G_UC01 #E7F3EC
  usecase "G-UC02\nInitialize an online service identity\n<<PARTIAL / INTEGRATION GAP>>" as G_UC02 #FFF1D6
  usecase "G-UC03\nRegister or recover a shared account\n<<TARGET / NO GAME EVIDENCE>>" as G_UC03 #FCE8E6
  usecase "G-UC04\nEdit the local display name\n<<SOURCE IMPLEMENTED>>" as G_UC04 #E7F3EC
  usecase "G-UC05\nComplete onboarding self-assessment\n<<TARGET / NO GAME EVIDENCE>>" as G_UC05 #FCE8E6
  usecase "G-UC06\nChoose a lobby character\n<<SOURCE IMPLEMENTED>>" as G_UC06 #E7F3EC
  usecase "G-UC58\nNavigate through a scene-loading screen\n<<SOURCE IMPLEMENTED>>" as G_UC58 #E7F3EC
  usecase "G-UC60\nReceive a classifier-based starting tier\n<<TARGET / NO GAME EVIDENCE>>" as G_UC60 #FCE8E6
}
A_player -- G_UC01
A_player -- G_UC02
A_ugs -- G_UC02
A_player -- G_UC03
A_player -- G_UC04
A_player -- G_UC05
A_player -- G_UC06
A_player -- G_UC58
A_player -- G_UC60
A_futureai -- G_UC60
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
