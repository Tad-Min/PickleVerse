%% ERD-DB-T13: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    bot_profiles {
        uuid bot_profile_id PK "NOT NULL"
        varchar_80 bot_code UK "NOT NULL"
        varchar_80 display_name "NOT NULL"
        smallint difficulty "NOT NULL"
        varchar_80 behavior_version "NOT NULL"
        jsonb configuration "NOT NULL"
        boolean is_active "NOT NULL"
    }
    matches {
        uuid match_id PK,FK "NOT NULL"
        varchar_120 external_match_id UK "NULL allowed"
        uuid room_id FK "NULL allowed"
        varchar_24 match_kind "NOT NULL"
        varchar_16 play_mode "NOT NULL"
        varchar_16 status "NOT NULL"
        varchar_40 region "NULL allowed"
        boolean is_night "NOT NULL"
        smallint target_points "NOT NULL"
        smallint best_of_games "NOT NULL"
        smallint winner_team_number FK "NULL allowed"
        varchar_160 end_reason "NULL allowed"
        timestamptz started_at "NULL allowed"
        timestamptz ended_at "NULL allowed"
        timestamptz created_at "NOT NULL"
    }
    match_teams {
        uuid match_id PK,FK "NOT NULL"
        smallint team_number PK "NOT NULL"
        varchar_100 display_name "NULL allowed"
    }
    match_participants {
        uuid participant_id PK "NOT NULL"
        uuid match_id FK "NOT NULL"
        smallint team_number FK "NOT NULL"
        smallint team_seat "NOT NULL"
        uuid user_id FK "NULL allowed"
        uuid bot_profile_id FK "NULL allowed"
        varchar_160 actor_external_id "NOT NULL"
        varchar_80 display_name_snapshot "NOT NULL"
        numeric_12_3 rating_snapshot "NOT NULL"
        varchar_80 paddle_item_code FK "NULL allowed"
        varchar_16 outcome "NULL allowed"
        boolean is_forfeit "NOT NULL"
        integer points_scored "NOT NULL"
        integer valid_returns "NOT NULL"
        integer valid_serves "NOT NULL"
        uuid reward_grant_id FK,UK "NULL allowed"
        timestamptz result_applied_at "NULL allowed"
    }
    match_games {
        uuid match_id PK,FK "NOT NULL"
        smallint game_number PK "NOT NULL"
        integer team_0_score "NOT NULL"
        integer team_1_score "NOT NULL"
        boolean is_completed "NOT NULL"
        smallint winner_team_number "NULL allowed"
    }
    rooms {
        uuid room_id PK "NOT NULL; reference only"
        varchar_16 room_code UK "NOT NULL; reference only"
        varchar_160 external_session_id UK "NULL allowed; reference only"
        uuid host_user_id FK "NOT NULL; reference only"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    cosmetic_items {
        varchar_80 item_code PK "NOT NULL; reference only"
        varchar_40 collection_code FK "NOT NULL; reference only"
    }
    reward_grants {
        uuid reward_grant_id PK "NOT NULL; reference only"
        uuid user_id FK "NOT NULL; reference only"
    }
    rooms |o--o{ matches : "room_id"
    match_teams |o--o{ matches : "match_id,winner_team_number"
    matches ||--o{ match_teams : "match_id"
    app_users |o--o{ match_participants : "user_id"
    bot_profiles |o--o{ match_participants : "bot_profile_id"
    cosmetic_items |o--o{ match_participants : "paddle_item_code"
    match_teams ||--o{ match_participants : "match_id,team_number"
    reward_grants |o--o{ match_participants : "reward_grant_id,user_id"
    matches ||--o{ match_games : "match_id"
