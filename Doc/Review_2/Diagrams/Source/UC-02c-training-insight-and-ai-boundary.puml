@startuml UC-02c
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-02c - Training insight and AI boundary
actor "Player" as A_player
actor "Future AI service" as A_futureai
rectangle "PickleVerse game / Training insight and AI boundary" {
  usecase "G-UC20\nInspect training progress and frequent errors\n<<SOURCE IMPLEMENTED>>" as G_UC20 #E7F3EC
  usecase "G-UC21\nReceive a next-drill recommendation\n<<PARTIAL / INTEGRATION GAP>>" as G_UC21 #FFF1D6
  usecase "G-UC22\nTrain offline and synchronize progress\n<<PARTIAL / INTEGRATION GAP>>" as G_UC22 #FFF1D6
  usecase "G-UC59\nReceive ML-based telemetry classification\n<<TARGET / NO GAME EVIDENCE>>" as G_UC59 #FCE8E6
}
A_player -- G_UC20
A_player -- G_UC21
A_player -- G_UC22
A_player -- G_UC59
A_futureai -- G_UC59
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
