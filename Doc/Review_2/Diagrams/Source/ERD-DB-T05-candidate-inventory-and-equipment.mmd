%% ERD-DB-T05: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    player_inventory {
        uuid user_id PK,FK "NOT NULL"
        varchar_80 item_code PK,FK "NOT NULL"
        varchar_24 acquisition_kind "NOT NULL"
        uuid purchase_id FK "NULL allowed"
        uuid reward_grant_id FK "NULL allowed"
        timestamptz acquired_at "NOT NULL"
    }
    player_equipment {
        uuid user_id PK,FK "NOT NULL"
        varchar_24 equipment_slot PK,FK "NOT NULL"
        varchar_80 item_code FK "NOT NULL"
        timestamptz equipped_at "NOT NULL"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    cosmetic_items {
        varchar_80 item_code PK "NOT NULL; reference only"
        varchar_40 collection_code FK "NOT NULL; reference only"
    }
    shop_purchases {
        uuid purchase_id PK "NOT NULL; reference only"
        uuid user_id FK "NOT NULL; reference only"
        varchar_80 item_code FK "NOT NULL; reference only"
        varchar_24 currency_code FK "NOT NULL; reference only"
        uuid wallet_transaction_id FK,UK "NOT NULL; reference only"
    }
    reward_grants {
        uuid reward_grant_id PK "NOT NULL; reference only"
        uuid user_id FK "NOT NULL; reference only"
    }
    app_users ||--o{ player_inventory : "user_id"
    cosmetic_items ||--o{ player_inventory : "item_code"
    shop_purchases |o--o{ player_inventory : "purchase_id,user_id,item_code"
    reward_grants |o--o{ player_inventory : "reward_grant_id,user_id"
    player_inventory ||--o{ player_equipment : "user_id,item_code"
    cosmetic_items ||--o{ player_equipment : "item_code,equipment_slot"
