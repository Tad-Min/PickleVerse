%% ERD-DB-T09: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    progress_definitions {
        varchar_80 definition_code PK "NOT NULL"
        varchar_180 title "NOT NULL"
        varchar_16 scope "NOT NULL"
        varchar_40 metric_code "NOT NULL"
        bigint target_value "NOT NULL"
        integer reward_xp "NOT NULL"
        text badge_asset_key "NULL allowed"
        boolean is_active "NOT NULL"
        integer content_version "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    definition_currency_rewards {
        varchar_80 definition_code PK,FK "NOT NULL"
        varchar_24 currency_code PK,FK "NOT NULL"
        bigint amount "NOT NULL"
    }
    definition_cosmetic_rewards {
        varchar_80 definition_code PK,FK "NOT NULL"
        varchar_80 item_code PK,FK "NOT NULL"
    }
    progress_periods {
        uuid period_id PK "NOT NULL"
        varchar_16 scope "NOT NULL"
        date start_date "NOT NULL"
        date end_date "NULL allowed"
        integer bonus_xp "NOT NULL"
        timestamptz created_at "NOT NULL"
    }
    currencies {
        varchar_24 currency_code PK "NOT NULL; reference only"
    }
    cosmetic_items {
        varchar_80 item_code PK "NOT NULL; reference only"
        varchar_40 collection_code FK "NOT NULL; reference only"
    }
    progress_definitions ||--o{ definition_currency_rewards : "definition_code"
    currencies ||--o{ definition_currency_rewards : "currency_code"
    progress_definitions ||--o{ definition_cosmetic_rewards : "definition_code"
    cosmetic_items ||--o{ definition_cosmetic_rewards : "item_code"
