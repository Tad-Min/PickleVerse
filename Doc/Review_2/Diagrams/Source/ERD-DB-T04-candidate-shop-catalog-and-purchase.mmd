%% ERD-DB-T04: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    item_collections {
        varchar_40 collection_code PK "NOT NULL"
        varchar_100 display_name "NOT NULL"
    }
    cosmetic_items {
        varchar_80 item_code PK "NOT NULL"
        varchar_40 collection_code FK "NOT NULL"
        varchar_120 display_name "NOT NULL"
        text description "NOT NULL"
        varchar_24 equipment_slot "NOT NULL"
        text unity_asset_key "NULL allowed"
        text thumbnail_key "NULL allowed"
        boolean is_default "NOT NULL"
        boolean is_active "NOT NULL"
        integer release_order "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    item_prices {
        varchar_80 item_code PK,FK "NOT NULL"
        varchar_24 currency_code PK,FK "NOT NULL"
        bigint price "NOT NULL"
    }
    shop_purchases {
        uuid purchase_id PK "NOT NULL"
        uuid user_id FK "NOT NULL"
        varchar_160 request_id "NOT NULL"
        varchar_80 item_code FK "NOT NULL"
        varchar_24 currency_code FK "NOT NULL"
        bigint paid_amount "NOT NULL"
        uuid wallet_transaction_id FK,UK "NOT NULL"
        timestamptz purchased_at "NOT NULL"
    }
    currencies {
        varchar_24 currency_code PK "NOT NULL; reference only"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    wallet_transactions {
        uuid wallet_transaction_id PK "NOT NULL; reference only"
        uuid user_id FK "NOT NULL; reference only"
        varchar_24 currency_code FK "NOT NULL; reference only"
        uuid reward_grant_id FK "NULL allowed; reference only"
    }
    item_collections ||--o{ cosmetic_items : "collection_code"
    cosmetic_items ||--o{ item_prices : "item_code"
    currencies ||--o{ item_prices : "currency_code"
    app_users ||--o{ shop_purchases : "user_id"
    cosmetic_items ||--o{ shop_purchases : "item_code"
    currencies ||--o{ shop_purchases : "currency_code"
    wallet_transactions ||--o{ shop_purchases : "wallet_transaction_id,user_id,currency_code"
