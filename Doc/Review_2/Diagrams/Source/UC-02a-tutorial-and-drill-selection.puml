@startuml UC-02a
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-02a - Tutorial and drill selection
actor "Player" as A_player
rectangle "PickleVerse game / Tutorial and drill selection" {
  usecase "G-UC07\nLearn court rules and faults\n<<SOURCE IMPLEMENTED>>" as G_UC07 #E7F3EC
  usecase "G-UC08\nPractice movement and running\n<<SOURCE IMPLEMENTED>>" as G_UC08 #E7F3EC
  usecase "G-UC09\nPractice nine shot input combinations\n<<SOURCE IMPLEMENTED>>" as G_UC09 #E7F3EC
  usecase "G-UC10\nReplay, skip or complete the tutorial\n<<SOURCE IMPLEMENTED>>" as G_UC10 #E7F3EC
  usecase "G-UC11\nBrowse and select unlocked drills\n<<SOURCE IMPLEMENTED>>" as G_UC11 #E7F3EC
}
A_player -- G_UC07
A_player -- G_UC08
A_player -- G_UC09
A_player -- G_UC10
A_player -- G_UC11
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
