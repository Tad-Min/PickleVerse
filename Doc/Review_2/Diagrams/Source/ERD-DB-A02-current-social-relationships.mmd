%% ERD-DB-A02: CURRENT SQL/EF — deployment not verified
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    FriendRequests {
        serial RequestId PK "NOT NULL"
        uuid SenderId FK "NOT NULL"
        uuid ReceiverId FK "NOT NULL"
        varchar_20 Status "NOT NULL"
        timestamptz CreatedAt "NOT NULL"
        timestamptz RespondedAt "NULL allowed"
    }
    Friendships {
        uuid UserId1 PK,FK "NOT NULL"
        uuid UserId2 PK,FK "NOT NULL"
        timestamptz CreatedAt "NOT NULL"
    }
    BlockedUsers {
        uuid UserId PK,FK "NOT NULL"
        uuid BlockedUserId PK,FK "NOT NULL"
        timestamptz CreatedAt "NOT NULL"
    }
    Users {
        uuid UserId PK "NOT NULL; reference only"
        varchar_254 Email UK "NOT NULL; reference only"
        int RoleId FK "NOT NULL; reference only"
    }
    Users ||--o{ FriendRequests : "SenderId"
    Users ||--o{ FriendRequests : "ReceiverId"
    Users ||--o{ Friendships : "UserId1"
    Users ||--o{ Friendships : "UserId2"
    Users ||--o{ BlockedUsers : "UserId"
    Users ||--o{ BlockedUsers : "BlockedUserId"
