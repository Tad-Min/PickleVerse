@startuml UC-07
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-07 - Social and leaderboard
actor "Player" as A_player
rectangle "PickleVerse game / Social and leaderboard" {
  usecase "G-UC51\nSearch and add or remove demo friends\n<<DEMO FIXTURES ONLY>>" as G_UC51 #EDE8FB
  usecase "G-UC52\nInspect the demo Elo leaderboard\n<<DEMO FIXTURES ONLY>>" as G_UC52 #EDE8FB
  usecase "G-UC53\nInvite or challenge an account friend\n<<TARGET / NO GAME EVIDENCE>>" as G_UC53 #FCE8E6
}
A_player -- G_UC51
A_player -- G_UC52
A_player -- G_UC53
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
