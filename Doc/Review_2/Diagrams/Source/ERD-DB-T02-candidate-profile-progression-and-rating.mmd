%% ERD-DB-T02: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    player_profiles {
        uuid user_id PK,FK "NOT NULL"
        varchar_18 display_name "NOT NULL"
        varchar_80 avatar_code "NOT NULL"
        varchar_16 character_variant "NOT NULL"
        varchar_16 locale "NOT NULL"
        jsonb settings "NOT NULL"
        integer profile_version "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    player_progression {
        uuid user_id PK,FK "NOT NULL"
        bigint total_xp "NOT NULL"
        numeric_18_3 active_seconds "NOT NULL"
        integer ranked_win_streak "NOT NULL"
        integer ranked_loss_streak "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    player_rating_states {
        uuid user_id PK,FK "NOT NULL"
        varchar_16 rating_system PK "NOT NULL"
        varchar_16 play_mode PK "NOT NULL"
        numeric_12_3 rating "NOT NULL"
        numeric_10_3 rating_deviation "NULL allowed"
        numeric_12_8 volatility "NULL allowed"
        numeric_5_2 reliability_percent "NOT NULL"
        integer rated_matches "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    app_users ||--o| player_profiles : "user_id"
    app_users ||--o| player_progression : "user_id"
    app_users ||--o{ player_rating_states : "user_id"
