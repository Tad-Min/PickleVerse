  usecase "BUC-07\nSubmit a drill attempt and award first-completion progress\n<<PARTIAL BACKEND SOURCE>>" as BUC_07 #FFF1D6
  usecase "BUC-08\nView technique mastery\n<<PARTIAL BACKEND SOURCE>>" as BUC_08 #FFF1D6
  usecase "BUC-09\nReceive personalized drill recommendations\n<<PARTIAL BACKEND SOURCE>>" as BUC_09 #FFF1D6
  usecase "BUC-10\nRecord a technique error and coaching observation\n<<PARTIAL BACKEND SOURCE>>" as BUC_10 #FFF1D6
}
A_registered -- BUC_06
A_registered -- BUC_07
A_registered -- BUC_08
A_registered -- BUC_09
A_registered -- BUC_10
