@startuml UC-06
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-06 - Shop, collection and preferences
actor "Player" as A_player
rectangle "PickleVerse game / Shop, collection and preferences" {
  usecase "G-UC47\nBrowse paddles and inspect a 3D preview\n<<SOURCE IMPLEMENTED>>" as G_UC47 #E7F3EC
  usecase "G-UC48\nBuy a cosmetic using virtual currency\n<<SOURCE IMPLEMENTED>>" as G_UC48 #E7F3EC
  usecase "G-UC49\nInspect the collection and equip a paddle\n<<SOURCE IMPLEMENTED>>" as G_UC49 #E7F3EC
  usecase "G-UC54\nChange audio, graphics and FPS preferences\n<<SOURCE IMPLEMENTED>>" as G_UC54 #E7F3EC
  usecase "G-UC55\nRebind keys and customize touch controls\n<<SOURCE IMPLEMENTED>>" as G_UC55 #E7F3EC
  usecase "G-UC57\nControl the lobby music playlist\n<<SOURCE IMPLEMENTED>>" as G_UC57 #E7F3EC
}
rectangle "Post-capstone / outside current baseline" #F1F3F5 {
  usecase "G-UC50\nTop up Elite Token with real money\n<<NOT IMPLEMENTED / OUT OF SCOPE>>" as G_UC50 #ECEFF3
}
A_player -- G_UC47
A_player -- G_UC48
A_player -- G_UC49
A_player -- G_UC54
A_player -- G_UC55
A_player -- G_UC57
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
