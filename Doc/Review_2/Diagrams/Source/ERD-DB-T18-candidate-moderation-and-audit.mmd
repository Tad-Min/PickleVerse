%% ERD-DB-T18: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    player_reports {
        uuid report_id PK "NOT NULL"
        uuid reporter_user_id FK "NOT NULL"
        uuid reported_user_id FK "NOT NULL"
        uuid match_id FK "NULL allowed"
        varchar_24 reason_code "NOT NULL"
        text description "NOT NULL"
        varchar_16 status "NOT NULL"
        uuid reviewed_by FK "NULL allowed"
        timestamptz reviewed_at "NULL allowed"
        text resolution "NULL allowed"
        timestamptz created_at "NOT NULL"
    }
    moderation_actions {
        uuid action_id PK "NOT NULL"
        uuid target_user_id FK "NOT NULL"
        uuid actor_user_id FK "NOT NULL"
        uuid report_id FK "NULL allowed"
        varchar_24 action_code "NOT NULL"
        text reason "NOT NULL"
        timestamptz effective_at "NOT NULL"
        timestamptz expires_at "NULL allowed"
    }
    audit_logs {
        bigint audit_id PK "NOT NULL"
        uuid actor_user_id FK "NULL allowed"
        varchar_80 action_code "NOT NULL"
        varchar_80 entity_type "NOT NULL"
        varchar_180 entity_key "NOT NULL"
        varchar_160 request_id "NULL allowed"
        jsonb details "NOT NULL"
        timestamptz occurred_at "NOT NULL"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    match_participants {
        uuid participant_id PK "NOT NULL; reference only"
        uuid match_id FK "NOT NULL; reference only"
        smallint team_number FK "NOT NULL; reference only"
        uuid user_id FK "NULL allowed; reference only"
        uuid bot_profile_id FK "NULL allowed; reference only"
        varchar_80 paddle_item_code FK "NULL allowed; reference only"
        uuid reward_grant_id FK,UK "NULL allowed; reference only"
    }
    app_users ||--o{ player_reports : "reporter_user_id"
    app_users ||--o{ player_reports : "reported_user_id"
    app_users |o--o{ player_reports : "reviewed_by"
    match_participants |o--o{ player_reports : "match_id,reported_user_id"
    app_users ||--o{ moderation_actions : "target_user_id"
    app_users ||--o{ moderation_actions : "actor_user_id"
    player_reports |o--o{ moderation_actions : "report_id"
    app_users |o--o{ audit_logs : "actor_user_id"
