%% ERD-DB-T06: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    techniques {
        varchar_40 technique_code PK "NOT NULL"
        varchar_120 display_name "NOT NULL"
        text description "NOT NULL"
    }
    lessons {
        varchar_80 lesson_code PK "NOT NULL"
        varchar_160 title "NOT NULL"
        text description "NOT NULL"
        smallint tier "NOT NULL"
        integer sort_order "NOT NULL"
        integer content_version "NOT NULL"
        boolean is_published "NOT NULL"
        uuid created_by FK "NULL allowed"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    drills {
        varchar_80 drill_code PK "NOT NULL"
        varchar_160 title "NOT NULL"
        text explanation "NOT NULL"
        text coaching_text "NOT NULL"
        smallint tier "NOT NULL"
        smallint trial_count "NOT NULL"
        smallint required_successes "NOT NULL"
        integer first_completion_xp "NOT NULL"
        bigint first_completion_tokenpad "NOT NULL"
        jsonb configuration "NOT NULL"
        integer content_version "NOT NULL"
        boolean is_published "NOT NULL"
        uuid created_by FK "NULL allowed"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    lesson_drills {
        varchar_80 lesson_code PK,FK "NOT NULL"
        varchar_80 drill_code PK,FK "NOT NULL"
        integer sort_order "NOT NULL"
    }
    drill_techniques {
        varchar_80 drill_code PK,FK "NOT NULL"
        varchar_40 technique_code PK,FK "NOT NULL"
        boolean is_primary "NOT NULL"
    }
    drill_prerequisites {
        varchar_80 drill_code PK,FK "NOT NULL"
        varchar_80 prerequisite_drill_code PK,FK "NOT NULL"
        smallint required_stars "NOT NULL"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    app_users |o--o{ lessons : "created_by"
    app_users |o--o{ drills : "created_by"
    lessons ||--o{ lesson_drills : "lesson_code"
    drills ||--o{ lesson_drills : "drill_code"
    drills ||--o{ drill_techniques : "drill_code"
    techniques ||--o{ drill_techniques : "technique_code"
    drills ||--o{ drill_prerequisites : "drill_code"
    drills ||--o{ drill_prerequisites : "prerequisite_drill_code"
