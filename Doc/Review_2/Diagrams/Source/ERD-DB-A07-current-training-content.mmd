erDiagram
    Techniques {
        serial TechniqueId PK "NOT NULL"
        varchar_254 TechniqueName UK "NOT NULL"
        varchar_254 Description "NOT NULL"
    }
    Lessons {
        serial LessonId PK "NOT NULL"
        varchar_254 LessonName "NOT NULL"
        varchar_254 Description "NOT NULL"
        varchar_25 Type "NOT NULL"
        int Target "NOT NULL"
        jsonb Reward "NOT NULL"
    }
    Drills {
        serial DrillId PK "NOT NULL"
        int TechniqueId FK "NOT NULL"
        varchar_254 DrillName "NOT NULL"
        varchar_254 Description "NOT NULL"
    }
    LessonDrills {
        int LessonId PK,FK "NOT NULL"
        int DrillId PK,FK "NOT NULL"
        int Target "NOT NULL"
    }
    Techniques ||--o{ Drills : "TechniqueId"
    Lessons ||--o{ LessonDrills : "LessonId"
