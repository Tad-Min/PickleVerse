%% ERD-DB-T16: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    coaching_feedback {
        uuid feedback_id PK "NOT NULL"
        uuid user_id FK "NOT NULL"
        uuid match_id FK "NULL allowed"
        uuid attempt_id FK "NULL allowed"
        text summary "NOT NULL"
        varchar_16 evaluator_kind "NOT NULL"
        varchar_80 evaluator_version "NOT NULL"
        integer processing_ms "NOT NULL"
        timestamptz generated_at "NOT NULL"
    }
    feedback_errors {
        uuid feedback_id PK,FK "NOT NULL"
        varchar_40 error_code PK,FK "NOT NULL"
        integer occurrences "NOT NULL"
    }
    feedback_tips {
        uuid feedback_id PK,FK "NOT NULL"
        varchar_80 tip_code PK,FK "NOT NULL"
        text tip_text_snapshot "NOT NULL"
        smallint sort_order "NOT NULL"
    }
    drill_recommendations {
        uuid recommendation_id PK "NOT NULL"
        uuid user_id FK "NOT NULL"
        varchar_80 drill_code FK "NOT NULL"
        uuid feedback_id FK "NULL allowed"
        smallint priority "NOT NULL"
        text reason "NOT NULL"
        varchar_80 recommender_version "NOT NULL"
        varchar_16 status "NOT NULL"
        timestamptz created_at "NOT NULL"
    }
    recommendation_errors {
        uuid recommendation_id PK,FK "NOT NULL"
        varchar_40 error_code PK,FK "NOT NULL"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    match_participants {
        uuid participant_id PK "NOT NULL; reference only"
        uuid match_id FK "NOT NULL; reference only"
        smallint team_number FK "NOT NULL; reference only"
        uuid user_id FK "NULL allowed; reference only"
        uuid bot_profile_id FK "NULL allowed; reference only"
        varchar_80 paddle_item_code FK "NULL allowed; reference only"
        uuid reward_grant_id FK,UK "NULL allowed; reference only"
    }
    training_attempts {
        uuid attempt_id PK "NOT NULL; reference only"
        uuid user_id FK "NOT NULL; reference only"
        varchar_80 drill_code FK "NOT NULL; reference only"
    }
    technique_errors {
        varchar_40 error_code PK "NOT NULL; reference only"
    }
    coaching_tips {
        varchar_80 tip_code PK "NOT NULL; reference only"
    }
    drills {
        varchar_80 drill_code PK "NOT NULL; reference only"
        uuid created_by FK "NULL allowed; reference only"
    }
    app_users ||--o{ coaching_feedback : "user_id"
    match_participants |o--o{ coaching_feedback : "match_id,user_id"
    training_attempts |o--o{ coaching_feedback : "attempt_id,user_id"
    coaching_feedback ||--o{ feedback_errors : "feedback_id"
    technique_errors ||--o{ feedback_errors : "error_code"
    coaching_feedback ||--o{ feedback_tips : "feedback_id"
    coaching_tips ||--o{ feedback_tips : "tip_code"
    app_users ||--o{ drill_recommendations : "user_id"
    drills ||--o{ drill_recommendations : "drill_code"
    coaching_feedback |o--o{ drill_recommendations : "feedback_id,user_id"
    drill_recommendations ||--o{ recommendation_errors : "recommendation_id"
    technique_errors ||--o{ recommendation_errors : "error_code"
