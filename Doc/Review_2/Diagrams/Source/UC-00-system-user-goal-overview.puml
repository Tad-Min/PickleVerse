@startuml UC-00
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-00 - System user-goal overview
actor "Player" as A_player
actor "Online player" as A_online
actor "Administrator" as A_admin
actor "Unity Gaming Services" as A_ugs
rectangle "PickleVerse scope / status-aware overview" {
  usecase "OV-01\nManage identity and lobby\n<<PARTIAL / INTEGRATION GAP>>" as OV_01 #FFF1D6
  usecase "OV-02\nLearn rules and train skills\n<<PARTIAL / INTEGRATION GAP>>" as OV_02 #FFF1D6
  usecase "OV-03\nPlay bot or online matches\n<<PARTIAL / INTEGRATION GAP>>" as OV_03 #FFF1D6
  usecase "OV-04\nInspect progression and replay\n<<SOURCE IMPLEMENTED>>" as OV_04 #E7F3EC
  usecase "OV-05\nPersonalize equipment and controls\n<<SOURCE IMPLEMENTED>>" as OV_05 #E7F3EC
  usecase "OV-06\nConnect with friends and ranking\n<<DEMO FIXTURES ONLY>>" as OV_06 #EDE8FB
  usecase "OV-07\nUse backend player services\n<<PARTIAL / INTEGRATION GAP>>" as OV_07 #FFF1D6
  usecase "OV-08\nOperate content and moderation\n<<PARTIAL / INTEGRATION GAP>>" as OV_08 #FFF1D6
}
A_player -- OV_01
A_player -- OV_02
A_player -- OV_03
A_player -- OV_04
A_player -- OV_05
A_player -- OV_06
A_online --|> A_player
A_online -- OV_03
A_ugs -- OV_03
A_admin -- OV_08
A_player -- OV_07
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
