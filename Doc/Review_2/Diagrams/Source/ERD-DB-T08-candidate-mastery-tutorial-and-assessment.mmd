%% ERD-DB-T08: CANDIDATE ONLY — not current EF / not deployed evidence
%% Solid relationship means declared SQL FK; current source inspection only.
%% Nullable column comment means optional parent; child lower bound always 0.
erDiagram
    player_technique_mastery {
        uuid user_id PK,FK "NOT NULL"
        varchar_40 technique_code PK,FK "NOT NULL"
        numeric_5_2 mastery_percent "NOT NULL"
        bigint sample_count "NOT NULL"
        varchar_80 evaluator_version "NOT NULL"
        timestamptz evaluated_at "NOT NULL"
    }
    player_tutorial_progress {
        uuid user_id PK,FK "NOT NULL"
        varchar_80 tutorial_code PK "NOT NULL"
        integer content_version "NOT NULL"
        integer last_step "NOT NULL"
        varchar_16 status "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    onboarding_assessments {
        uuid assessment_id PK "NOT NULL"
        uuid user_id FK "NOT NULL"
        varchar_24 self_assessed_tier "NULL allowed"
        jsonb answers "NOT NULL"
        varchar_16 rating_system "NOT NULL"
        numeric_12_3 estimated_rating "NULL allowed"
        varchar_80 classifier_version "NULL allowed"
        timestamptz completed_at "NOT NULL"
    }
    app_users {
        uuid user_id PK "NOT NULL; reference only"
    }
    techniques {
        varchar_40 technique_code PK "NOT NULL; reference only"
    }
    app_users ||--o{ player_technique_mastery : "user_id"
    techniques ||--o{ player_technique_mastery : "technique_code"
    app_users ||--o{ player_tutorial_progress : "user_id"
    app_users ||--o{ onboarding_assessments : "user_id"
