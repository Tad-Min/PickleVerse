@startuml UC-08d
left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #314C68
  FontColor #102333
}
skinparam actor {
  BorderColor #314C68
  FontColor #102333
}
title UC-08d - Backend economy and reward claims
actor "Registered API user" as A_registered
rectangle "Independent backend API / partial source" {
  usecase "BUC-13\nBrowse store catalog and currency balances\n<<PARTIAL BACKEND SOURCE>>" as BUC_13 #FFF1D6
  usecase "BUC-14\nPurchase a cosmetic with virtual currency\n<<PARTIAL BACKEND SOURCE>>" as BUC_14 #FFF1D6
  usecase "BUC-15\nView inventory and equip a cosmetic\n<<PARTIAL BACKEND SOURCE>>" as BUC_15 #FFF1D6
  usecase "BUC-16\nView and claim an achievement\n<<PARTIAL BACKEND SOURCE>>" as BUC_16 #FFF1D6
  usecase "BUC-17\nView and claim a mission reward\n<<PARTIAL BACKEND SOURCE>>" as BUC_17 #FFF1D6
}
A_registered -- BUC_13
A_registered -- BUC_14
A_registered -- BUC_15
A_registered -- BUC_16
A_registered -- BUC_17
legend bottom
  Green: source implemented; amber: partial / integration gap.
  Purple: demo fixtures only; red: target with no game evidence.
  Grey isolated use case: outside baseline; no implemented actor path.
  Source coverage is not runtime acceptance or review approval.
endlegend
@enduml
