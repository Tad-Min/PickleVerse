<mxfile host="app.diagrams.net"><diagram id="ACT-WF06" name="ACT-WF06 WF06 Administer users content and operations"><mxGraphModel dx="1400" dy="1615" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1615"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Actor: Administrator, Reporting player" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="145" width="1000" height="110" as="geometry" /></mxCell><mxCell id="step1" value="&lt;b&gt;1 Authenticate as administrator&lt;/b&gt;&lt;br&gt;Responsibility: Admin browser and auth API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="315" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step2" value="&lt;b&gt;2 Inspect a user or moderation report&lt;/b&gt;&lt;br&gt;Responsibility: Administrator and protected API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="485" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step3" value="&lt;b&gt;3 Apply valid access/status decision&lt;/b&gt;&lt;br&gt;Responsibility: Administrator and user API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="655" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step4" value="&lt;b&gt;4 Create and publish playable lesson configuration&lt;/b&gt;&lt;br&gt;Responsibility: Administrator and CMS API target" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" verte