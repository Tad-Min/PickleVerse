<mxfile host="app.diagrams.net"><diagram id="ACT-WF05" name="ACT-WF05 WF05 Review progress and claim rewards"><mxGraphModel dx="1400" dy="1615" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1615"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Actor: Player" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="145" width="1000" height="110" as="geometry" /></mxCell><mxCell id="step1" value="&lt;b&gt;1 Refresh server progress&lt;/b&gt;&lt;br&gt;Responsibility: Player and state API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="315" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step2" value="&lt;b&gt;2 Inspect stars and error aggregates&lt;/b&gt;&lt;br&gt;Responsibility: Player and Unity progress UI" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="485" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step3" value="&lt;b&gt;3 Open suggested drill or replay&lt;/b&gt;&lt;br&gt;Responsibility: Player and Unity drill/replay" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="655" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step4" value="&lt;b&gt;4 Claim eligible mission/achievement reward&lt;/b&gt;&lt;br&gt;Responsibility: Player and command API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="825" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step5" value="&lt;b&gt;5 Refresh wallet and continuation target&lt;/b&gt;&lt;br&gt;Responsibility: Game API and Unity snapshot" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="995" width="1000" height="115" as="geometry" /></mxCell><mxCell id="end" value="&lt;b&gt;Business outcome&lt;/b&gt;&lt;br&gt;The player sees next practice, history and exactly-once rewards." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="1165" width="1000" height="130" as="geometry" /></mxCell><mxCell id="exception" value="&lt;b&gt;Exception path&lt;/b&gt;&lt;br&gt;A repeated claim does not credit again; offline practice/sync is a required gap&lt;br&gt;and must be demonstrated after implementation.&lt;br&gt;Reject mutation; preserve state; show retry or policy outcome." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="1335" width="1000" height="190" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="start" target="step1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="step5" target="end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="step2" target="exception"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="542.5" /><mxPoint x="1270" y="1430.0" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>