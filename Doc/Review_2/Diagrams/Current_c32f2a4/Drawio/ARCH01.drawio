<mxfile host="app.diagrams.net"><diagram id="ARCH01" name="ARCH01 Architecture visible in current source"><mxGraphModel dx="1400" dy="1116" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1116"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="unity" value="&lt;b&gt;Unity client&lt;/b&gt;&lt;br&gt;Account UI and REST adapters&lt;br&gt;Training and progression snapshot&lt;br&gt;uGUI controls and match rendering" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="560" height="151" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;ASP NET Core API net10&lt;/b&gt;&lt;br&gt;JWT and Admin RBAC&lt;br&gt;Shared C# rules and idempotent commands&lt;br&gt;Training / online results / social /&lt;br&gt;replay" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="145" width="560" height="180" as="geometry" /></mxCell><mxCell id="photon" value="&lt;b&gt;Photon Fusion Shared&lt;/b&gt;&lt;br&gt;Peer StateAuthority simulation&lt;br&gt;Session and command transport&lt;br&gt;Dedicated server requirement remains open" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="560" height="151" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL and Redis&lt;/b&gt;&lt;br&gt;37 SQL tables plus JSONB&lt;br&gt;Atomic durable commands and ledger&lt;br&gt;Transient queue and leaderboard cache" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="560" height="151" as="geometry" /></mxCell><mxCell id="web" value="&lt;b&gt;React a