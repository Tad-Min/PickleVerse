<mxfile host="app.diagrams.net"><diagram id="LOGICAL01" name="LOGICAL01 Logical entities and association meaning"><mxGraphModel dx="1440" dy="1146" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="1146"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="account" value="&lt;b&gt;Account and player&lt;/b&gt;&lt;br&gt;User 1 — 0..1 PlayerProfile row&lt;br&gt;Role 1 — many Users&lt;br&gt;Profile 1 — many owned records" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="620" height="151" as="geometry" /></mxCell><mxCell id="learning" value="&lt;b&gt;Learning catalog and attempt&lt;/b&gt;&lt;br&gt;Lesson many — many Drill via LessonDrills&lt;br&gt;Technique 1 — many Drills&lt;br&gt;Player 1 — many TrainingSessions" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="155" width="620" height="151" as="geometry" /></mxCell><mxCell id="match" value="&lt;b&gt;Match and participant result&lt;/b&gt;&lt;br&gt;GameMatch 1 — many GameMatchPlayers&lt;br&gt;History 1 — many PlayerMatchHistory&lt;br&gt;Player many — many Match via participants" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="620" height="151" as="geometry" /></mxCell><mxCell id="reward" value="&lt;b&gt;Economy and objectives&lt;/b&gt;&lt;br&gt;Player many — many Cosmetic via ownership&lt;br&gt;Player many — many Mission/Achievement&lt;br&gt;Wallet 1 currency/player; ledger many entries" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="530" width="620" height="151" as="geometry" /></mxCell><mxCell id="social" value="&lt;b&gt;Social relationship&lt;/b&gt;&lt;br&gt;Users many — many via Friendship&lt;br&gt;Request has exactly one sender and recipient&lt;br&gt;Block has owner and blocked user" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="620" height="151" as="geometry" /></mxCell><mxCell id="replay" value="&lt;b&gt;Replay and progress aggregate&lt;/b&gt;&lt;br&gt;Match/player 1 — many replay chunks&lt;br&gt;Player 1 — 0..1 GameProgress row&lt;br&gt;JSONB aggregate members are not SQL tables" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="905" width="620" height="151" as="geometry" /></mxCell><mxCell id="edge0" value="owns attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="account" target="learning"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="participates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="account" target="match"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="relates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="account" target="social"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="account" target="reward"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="recorded as" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="match" target="replay"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>