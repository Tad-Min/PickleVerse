mxPoint x="1270" y="1430.0" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="ACT-WF03" name="ACT-WF03 WF03 Find accept and finish an online match"><mxGraphModel dx="1400" dy="1615" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1615"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Actor: Online player A, Online player B, Photon service" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="145" width="1000" height="110" as="geometry" /></mxCell><mxCell id="step1" value="&lt;b&gt;1 Join eligible skill queue&lt;/b&gt;&lt;br&gt;Responsibility: Player and queue API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="315" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step2" value="&lt;b&gt;2 Poll canonical offer and accept&lt;/b&gt;&lt;br&gt;Responsibility: Player decision and Game API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="485" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step3" value="&lt;b&gt;3 Wait for all required human acceptances&lt;/b&gt;&lt;br&gt;Responsibility: Game API and required peers" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="655" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step4" value="&lt;b&gt;4 Start Photon Shared session and play&lt;/b&gt;&lt;br&gt;Responsibility: Players and Photon Shared peers" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="825" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step5" value="&lt;b&gt;5 Report consistent results and read finalized rating&lt;/b&gt;&lt;br&gt;Responsibility: Participant reports and Game API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="995" width="1000" height="115" as="geometry" /></mxCell><mxCell id="end" value="&lt;b&gt;Business outcome&lt;/b&gt;&lt;br&gt;A canonical match result updates each participant once." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="1165" width="1000" height="130" as="geometry" /></mxCell><mxCell id="exception" value="&lt;b&gt;Exception path&lt;/b&gt;&lt;br&gt;A decline/timeout cancels the offer; a conflicting report blocks normal&lt;br&gt;finalization and applies server policy.&lt;br&gt;Reject mutation; preserve state; show retry or policy outcome." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="1335" width="1000" height="190" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="start" target="step1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCel