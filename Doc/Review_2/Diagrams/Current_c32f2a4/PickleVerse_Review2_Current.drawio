;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="655" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step4" value="&lt;b&gt;4 Create and publish playable lesson configuration&lt;/b&gt;&lt;br&gt;Responsibility: Administrator and CMS API target" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="825" width="1000" height="115" as="geometry" /></mxCell><mxCell id="step5" value="&lt;b&gt;5 Inspect period-defined operational analytics&lt;/b&gt;&lt;br&gt;Responsibility: Administrator and analytics API target" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="995" width="1000" height="115" as="geometry" /></mxCell><mxCell id="end" value="&lt;b&gt;Business outcome&lt;/b&gt;&lt;br&gt;Authorized actions change service data and support operational decisions." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="1165" width="1000" height="130" as="geometry" /></mxCell><mxCell id="exception" value="&lt;b&gt;Exception path&lt;/b&gt;&lt;br&gt;A non-admin request is denied; invalid publication/status data leaves existing&lt;br&gt;records unchanged.&lt;br&gt;Reject mutation; preserve state; show retry or policy outcome." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f6f9fd;strokeColor=#344c68;fontSize=22;spacing=15;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="180" y="1335" width="1000" height="190" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="start" target="step1"><mxGeometry relative="1" as="geometry" /></mxCell><mx