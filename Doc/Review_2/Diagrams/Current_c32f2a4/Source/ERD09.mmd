erDiagram
  PlayerTechniqueMastery {
    UUID PlayerId PK,FK "required"
    INT TechniqueId PK,FK "required"
    INT TotalAttempts "required"
    INT TotalErrors "required"
    SMALLINT MasteryScore "nullable"
    TIMESTAMPTZ LastUpdatedAt "required"
  }
  PlayerProfiles ||--o{ PlayerTechniqueMastery : "PlayerId"
  Techniques ||--o{ PlayerTechniqueMastery : "TechniqueId"
  PlayerTechniquesErrors {
    SERIAL ErrorLogId PK "required"
    UUID PlayerId FK "required"
    INT TechniqueId FK "required"
    UUID MatchId FK "nullable"
    INT LessonId FK "nullable"
    VARCHAR_50 ErrorType "required"
    TEXT CoachingTip "required"
    TIMESTAMPTZ CreatedAt "required"
  }
  PlayerProfiles ||--o{ PlayerTechniquesErrors : "PlayerId"
  Techniques ||--o{ PlayerTechniquesErrors : "TechniqueId"
  MatchHistory |o--o{ PlayerTechniquesErrors : "MatchId"
  Lessons |o--o{ PlayerTechniquesErrors : "LessonId"
  PlayerLessonDrills {
    UUID PlayerId PK,FK "required"
    INT LessonId PK,FK "required"
    INT DrillId PK,FK "required"
    INT Score "required"
    BOOLEAN IsClaimedReward "required"
  }
  PlayerProfiles ||--o{ PlayerLessonDrills : "PlayerId"
  Lessons ||--o{ PlayerLessonDrills : "LessonId"
  Drills ||--o{ PlayerLessonDrills : "DrillId"
  TrainingSessions {
    UUID AttemptId PK "required"
    UUID PlayerId FK "required"
    INT LessonId FK "required"
    INT DrillId FK "required"
    JSONB Data "required"
    BOOLEAN Completed "required"
    TIMESTAMPTZ CreatedAt "required"
    TIMESTAMPTZ UpdatedAt "required"
  }
  PlayerProfiles ||--o{ TrainingSessions : "PlayerId"
  Lessons ||--o{ TrainingSessions : "LessonId"
  Drills ||--o{ TrainingSessions : "DrillId"
  LessonDrills ||--o{ TrainingSessions : "LessonId,DrillId"
