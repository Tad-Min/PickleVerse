stateDiagram-v2
  state "Unregistered" as S0
  state "Unverified" as S1
  state "Verified" as S2
  state "Authenticated" as S3
  state "SignedOut" as S4
  [*] --> S0
  S0 --> S1: 1 valid registration
  S1 --> S2: 2 valid unexpired OTP
  S2 --> S3: 3 valid login
  S3 --> S3: 4 rotate valid refresh token
  S3 --> S4: 5 logout/revoke
  S4 --> S3: 6 valid login
  S1 --> S1: 7 reject wrong or expired OTP