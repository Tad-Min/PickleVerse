@startuml
left to right direction
actor "Player" as Player
actor "Administrator" as Admin
rectangle "PickleVerse" {
  usecase "UC13\nView match end and player presentation" as UC13
  usecase "UC14\nQueue for a skill matched game" as UC14
  usecase "UC15\nAccept decline or time out a match offer" as UC15
  usecase "UC16\nCreate or join a private room" as UC16
  usecase "UC17\nManage teams and start a private match" as UC17
  usecase "UC18\nPlay an online singles or doubles match" as UC18
}
Player --> UC13
Player --> UC14
Player --> UC15
Player --> UC16
Player --> UC17
Player --> UC18
@enduml