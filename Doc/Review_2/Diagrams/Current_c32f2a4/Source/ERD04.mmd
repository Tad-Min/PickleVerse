erDiagram
  MatchHistory {
    UUID MatchId PK "required"
    TIMESTAMPTZ CreatedAt "required"
    VARCHAR_25 MatchType "required"
    INT TeamAScore "required"
    INT TeamBScore "required"
  }
  PlayerMatchHistory {
    UUID PlayerId PK,FK "required"
    UUID MatchId PK,FK "required"
    VARCHAR_25 Status "required"
    BOOLEAN IsTeamA "required"
    INT ReceivedElo "required"
  }
  PlayerProfiles ||--o{ PlayerMatchHistory : "PlayerId"
  MatchHistory ||--o{ PlayerMatchHistory : "MatchId"
  ReportPlayerInMatch {
    UUID ReporterId PK,FK "required"
    UUID ReportedPlayerId PK,FK "required"
    UUID MatchId PK,FK "required"
    VARCHAR_254 Reason "required"
    VARCHAR_20 Status "required"
    TIMESTAMPTZ CreatedAt "required"
    TIMESTAMPTZ UpdatedAt "required"
  }
  PlayerProfiles ||--o{ ReportPlayerInMatch : "ReporterId"
  PlayerProfiles ||--o{ ReportPlayerInMatch : "ReportedPlayerId"
  MatchHistory ||--o{ ReportPlayerInMatch : "MatchId"
  MatchHistoryReplay {
    UUID MatchId PK,FK "required"
    VARCHAR_1000 ReplayUrl "required"
  }
  MatchHistory ||--o| MatchHistoryReplay : "MatchId"
