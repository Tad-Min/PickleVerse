erDiagram
  FriendRequests {
    SERIAL RequestId PK "required"
    UUID SenderId FK "required"
    UUID ReceiverId FK "required"
    VARCHAR_20 Status "required"
    TIMESTAMPTZ CreatedAt "required"
    TIMESTAMPTZ RespondedAt "nullable"
  }
  Users ||--o{ FriendRequests : "SenderId"
  Users ||--o{ FriendRequests : "ReceiverId"
  Friendships {
    UUID UserId1 PK,FK "required"
    UUID UserId2 PK,FK "required"
    TIMESTAMPTZ CreatedAt "required"
  }
  Users ||--o{ Friendships : "UserId1"
  Users ||--o{ Friendships : "UserId2"
  BlockedUsers {
    UUID UserId PK,FK "required"
    UUID BlockedUserId PK,FK "required"
    TIMESTAMPTZ CreatedAt "required"
  }
  Users ||--o{ BlockedUsers : "UserId"
  Users ||--o{ BlockedUsers : "BlockedUserId"
