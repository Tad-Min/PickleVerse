rectangle "PickleVerse" {
  usecase "UC25\nClaim mission achievement or streak reward" as UC25
  usecase "UC26\nBuy and equip a cosmetic" as UC26
  usecase "UC27\nPractice offline and synchronize" as UC27
  usecase "UC28\nSign in to the administration site" as UC28
