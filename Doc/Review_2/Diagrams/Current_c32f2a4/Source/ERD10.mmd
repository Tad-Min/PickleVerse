erDiagram
  GameMatches {
    UUID MatchId PK "required"
    UUID OwnerId FK "nullable"
    VARCHAR_32 Kind "required"
    VARCHAR_20 Status "required"
    JSONB Data "required"
    TIMESTAMPTZ CreatedAt "required"
    TIMESTAMPTZ UpdatedAt "required"
  }
  PlayerProfiles |o--o{ GameMatches : "OwnerId"
  GameMatchPlayers {
    UUID MatchId PK,FK "required"
    UUID PlayerId PK,FK "required"
    SMALLINT Team "required"
    BOOLEAN Accepted "required"
    JSONB Report "nullable"
    VARCHAR_64 Fingerprint "nullable"
    TIMESTAMPTZ LastSeenAt "required"
  }
  GameMatches ||--o{ GameMatchPlayers : "MatchId"
  PlayerProfiles ||--o{ GameMatchPlayers : "PlayerId"
