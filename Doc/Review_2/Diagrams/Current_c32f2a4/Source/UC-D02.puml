@startuml
left to right direction
actor "Player" as Player
actor "Administrator" as Admin
rectangle "PickleVerse" {
  usecase "UC07\nPractice doubles positioning and movement" as UC07
  usecase "UC08\nReview a completed drill without reward" as UC08
  usecase "UC09\nInspect progress and resume learning" as UC09
  usecase "UC10\nPlay a configurable bot match" as UC10
  usecase "UC11\nMove sprint and execute shots" as UC11
  usecase "UC12\nPause request timeout and leave" as UC12
}
Player --> UC07
Player --> UC08
Player --> UC09
Player --> UC10
Player --> UC11
Player --> UC12
@enduml