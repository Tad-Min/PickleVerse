@startuml r3_cerd_account
!include _style.iuml
hide circle
hide empty members
skinparam linetype ortho
entity "ACCOUNT" as ACCOUNT {
  * AccountId
  --
  Email
  PasswordHash
  Status
}
entity "ROLE" as ROLE {
  * RoleId
  --
  RoleName
}
entity "PLAYER_PROFILE" as PLAYER_PROFILE {
  * PlayerId
  --
  PlayerName
  Elo
  Level
  ExperienceChoice
}
entity "VERIFICATION_CODE" as VERIFICATION_CODE {
  * CodeId
  --
  ExpiresAt
}
ROLE ||--o{ ACCOUNT : "has role"
ACCOUNT ||--|| PLAYER_PROFILE : "owns profile"
ACCOUNT ||--o{ VERIFICATION_CODE : "verifies"
ACCOUNT }o--o{ ACCOUNT : "friend of"
ACCOUNT }o--o{ ACCOUNT : "blocks"
@enduml
