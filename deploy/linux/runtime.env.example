# Copy to .env in the directory selected by the GitHub Actions PKV_DEPLOY_ROOT variable.
# Restrict it to the deploy user.
# Image repository and release suffix from the workflow summary.
DOCKER_REPOSITORY=tadminm/pickelverse
DOCKER_TAG_RELEASE=

# Absolute path to the host data directories.
PKV_DATA_ROOT=/mnt/data/pickleverse/data
# Existing PostgreSQL/S3 stores must use their existing credentials at cutover.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
JWT_KEY=
AI_SERVICE_KEY=
PKV_GAME_SERVER_KEY=

# Optional SMTP configuration for registration/OTP and password recovery.
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=

# Existing bind/port defaults. Preserve current proxy/firewall settings as needed.
PKV_API_BIND=0.0.0.0
API_PORT=8080
WEB_BIND=127.0.0.1
WEB_PORT=3000
POSTGRES_PORT=15432
POSTGRES_MAX_POOL_SIZE=40
REDIS_PORT=16379
S3_PORT=19000
PKV_GAME_CPUS=2
PKV_GAME_MEMORY=2g

# Set only for a coaching calibration artifact already approved and copied to models/.
AI_COACHING_CALIBRATION_SHA256=
