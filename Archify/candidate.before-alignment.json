  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path: leaderboard lookup",
      "items": [
        "Follow Unity → API → Redis for cached ranking reads.",
        "The API validates JWTs; admin routes require the Admin role.",
        "Profiles and social relationships still read PostgreSQL on cache hits."
      ]
    },
    {
      "dot": "amber",
      "title": "Cache and PostgreSQL fallback",
      "items": [
        "Cache miss: the API rebuilds Redis rankings from SQL.",
        "RedisException: leaderboard ranking falls back to PostgreSQL.",
        "Matchmaking has no SQL fallback; durable game state stays in PostgreSQL."
      ]
    },
    {
      "dot": "violet",
      "title": "Hybrid AI runs asynchronously",
      "items": [
        "Flagged ingest accepts completed-session telemetry into PostgreSQL jobs.",
        "A worker inside the API leases jobs, calls FastAPI with X-AI-Key, then saves analysis to SQL.",
        "Compose defaults AI flags off; effective .env settings were not inspected."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and external dependencies",
      "items": [
        "Unity connects directly to Photon; the API is not the gameplay relay.",
        "SMTP verification uses a configured external provider with STARTTLS.",
        "Compose uses HTTP and loopback service ports; the bridge is not a network ACL. Production TLS is outside this topology."
      ]
    },
    {
      "dot": "slate",
      "title": "Scope and source evidence",
      "items": [
        "Eight runtime components; the worker is grouped inside its API host.",
        "Browser arrows assume live API mode; VITE_USE_MOCK_DATA can bypass it.",
        "Current worktree, including uncommitted AI and runtime changes. Sources use a local evidence snapshot; see source-notes.md."
      ]
    }
  ]
